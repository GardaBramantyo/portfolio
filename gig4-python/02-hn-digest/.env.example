# Copy this file to .env and fill it in. Never commit or share .env.
# Only needed for --email --send and for --sheet-id.

# Email digest (SMTP). Gmail: smtp.gmail.com, port 587, starttls, and an App Password.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
DIGEST_FROM=digest@example.com
DIGEST_TO=you@example.com

# Google Sheets output: path to a service-account JSON key. Share the sheet with the
# service account's e-mail address (Editor) first.
GOOGLE_SERVICE_ACCOUNT_FILE=
